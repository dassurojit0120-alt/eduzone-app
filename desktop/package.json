{
  "name": "eduzone-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "EduZone by Surojit",
  "author": "Surojit",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.surojit.eduzone",
    "productName": "EduZone",
    "files": ["main.js", "server.js", "app/**/*"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "EduZone-Setup.exe",
      "shortcutName": "EduZone"
    }
  }
}
